{
  "name": "@opsfoundry/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "node tests/client_isolation.test.mjs",
    "test:integration": "node tests/runtime_integration.test.mjs",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@opsfoundry/types": "workspace:*",
    "@supabase/supabase-js": "2.49.1",
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "drizzle-kit": "0.31.11",
    "typescript": "7.0.2"
  }
}
