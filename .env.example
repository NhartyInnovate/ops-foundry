# ==============================================================================
# OPS FOUNDRY — ROOT ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env.local for local development. NEVER commit real secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SCOPED APPLICATION RUNTIME DATABASE IDENTITIES (Supabase Pooler, Port 6543)
# ------------------------------------------------------------------------------
# Corporate Next.js Server Actions (Role: ops_corp_runtime - INSERT on inquiries/outbox only)
CORP_DATABASE_URL="postgresql://ops_corp_runtime.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Academy Next.js Server Actions (Role: ops_intake_runtime - INSERT on admissions/history/outbox only)
ACADEMY_DATABASE_URL="postgresql://ops_intake_runtime.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Outbox Background Worker Service (Role: ops_worker_runtime - SELECT/UPDATE on outbox only)
WORKER_DATABASE_URL="postgresql://ops_worker_runtime.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true"

# CI/CD Pipeline & Migration Owner ONLY (Role: postgres superuser - DDL & Migrations)
MIGRATION_DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres"

# Optional Local Development Shared Database (requires ALLOW_INSECURE_DEV_SHARED_DB=true)
# LOCAL_DEV_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/opsfoundry"
# ALLOW_INSECURE_DEV_SHARED_DB="false"

# ------------------------------------------------------------------------------
# 2. PUBLIC APPLICATION & CROSS-PROPERTY URLS
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CORPORATE_URL="https://ops-foundry-two.vercel.app"
NEXT_PUBLIC_ACADEMY_URL="https://academy-neon-gamma.vercel.app"

# ------------------------------------------------------------------------------
# 3. SUPABASE PROJECT CONFIGURATION (Public & Service Keys)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ------------------------------------------------------------------------------
# 4. WORKER & CRON SCHEDULER AUTHENTICATION
# ------------------------------------------------------------------------------
CRON_SECRET="generate-a-secure-random-32-byte-hex-string-for-cron-auth"

# ------------------------------------------------------------------------------
# 5. ANTI-SPAM & ABUSE PROTECTION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAA..."
TURNSTILE_SECRET_KEY="0x4AAAAAA..."
IP_HASH_SALT="generate-a-secure-random-salt-for-ip-hashing"

# ------------------------------------------------------------------------------
# 6. OUTBOUND NOTIFICATIONS & TRANSACTIONAL DELIVERY
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_123456789_..."
CORPORATE_NOTIFICATION_EMAIL="team@opsfoundry.co"
RESEND_FROM_EMAIL="Ops Foundry <notifications@opsfoundry.co>"
TRIAGE_WEBHOOK_URL="https://hooks.slack.com/services/..."
TRIAGE_WEBHOOK_SECRET="generate-hmac-sha256-signing-secret"
